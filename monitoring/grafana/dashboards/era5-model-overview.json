        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 8,
      "title": "Scientific quality",
      "type": "row",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 9,
      "title": "Overall / surface / pressure NRMSE",
      "description": "Latitude-weighted normalized RMSE after inverse normalization to physical units. Lower is better.",
      "type": "bargauge",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "era5_codec_overall_score",
          "instant": true,
          "legendFormat": "Overall",
          "refId": "A"
        },
        {
          "expr": "era5_codec_surface_score",
          "instant": true,
          "legendFormat": "Surface",
          "refId": "B"
        },
        {
          "expr": "era5_codec_pressure_score",
          "instant": true,
          "legendFormat": "Pressure levels",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.15},
              {"color": "orange", "value": 0.25},
              {"color": "red", "value": 0.4}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": false},
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      }
    },
