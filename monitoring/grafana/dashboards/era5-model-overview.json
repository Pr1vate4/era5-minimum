{
  "uid": "era5-model-overview",
  "title": "ERA5 Model — Compression & Quality",
  "description": "Validated physical-space, latitude-weighted metrics from the selected real ERA5 model artifact.",
  "tags": ["era5", "model", "compression", "quality", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [
    {
      "title": "API telemetry",
      "type": "link",
      "url": "/d/era5-api-overview/era5-api-overview",
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "http://localhost:9090",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Result status",
      "type": "row",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "title": "Artifact contract",
      "description": "1 only when both JSON artifacts satisfy the canonical scientific contract.",
      "type": "stat",
      "gridPos": {"x": 0, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "era5_codec_artifact_ready", "instant": true, "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "INVALID", "color": "red"},
                "1": {"text": "VALID", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Serialized compression ratio",
      "description": "Measured raw tensor bytes / actual serialized bitstream bytes.",
      "type": "stat",
      "gridPos": {"x": 4, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "era5_codec_actual_compression_ratio",
          "instant": true,
          "legendFormat": "serialized",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "green", "value": 32}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Tensor element ratio",
      "description": "Input tensor elements / latent tensor elements. This is not a serialized compression ratio.",
      "type": "stat",
      "gridPos": {"x": 8, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "era5_codec_tensor_compression_ratio",
          "instant": true,
          "legendFormat": "tensor",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "color": {"mode": "fixed", "fixedColor": "purple"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "title": "Exact quantized-symbol roundtrip",
      "description": "Exact equality after serializing and decoding all evaluated quantized symbols.",
      "type": "stat",
      "gridPos": {"x": 12, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "era5_codec_exact_roundtrip", "instant": true, "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "FAILED", "color": "red"},
                "1": {"text": "VERIFIED", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "title": "Serialized bitstream",
      "type": "stat",
