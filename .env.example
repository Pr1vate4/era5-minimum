# Local Docker Compose defaults. Paths are relative to the repository root.
API_PORT=8000
API_INTERNAL_PORT=8000
LOG_LEVEL=info

APP_UID=1000
APP_GID=1000

DATA_DIR=./data
OUTPUTS_DIR=./outputs
CHECKPOINTS_DIR=./checkpoints
BITSTREAMS_DIR=./bitstreams
ARTIFACTS_DIR=./artifacts
SUBMISSION_DIR=./submission

CUDA_VISIBLE_DEVICES=0

# Local monitoring stack. Change the Grafana password outside local development.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.0.0
