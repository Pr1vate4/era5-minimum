# Local Docker Compose defaults. Paths are relative to the repository root.
API_PORT=8000
API_INTERNAL_PORT=8000
LOG_LEVEL=info
ML_EXPORTER_BIND_ADDRESS=127.0.0.1
ML_EXPORTER_PORT=9101
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

APP_UID=1000
APP_GID=1000

DATA_DIR=./data
OUTPUTS_DIR=./outputs
CHECKPOINTS_DIR=./checkpoints
BITSTREAMS_DIR=./bitstreams
ARTIFACTS_DIR=./artifacts
SUBMISSION_DIR=./submission

CUDA_VISIBLE_DEVICES=0

# Development-only visual field. Demo layers are always labelled and are not ERA5.
VITE_ENABLE_GLOBE_DEMO=false

# Optional frontend integrations.
VITE_CODEC_API_BASE_URL=
VITE_GRAFANA_URL=http://localhost:3000
